# Voxa Web (browser runtime) public settings.
# Copy to .env.web.local and edit; run with `pnpm run dev:web` / `pnpm run build:web`.
# Only non-secret NEXT_PUBLIC_VOXA_* values belong here: they are compiled into
# the browser bundle. Never put database URLs, credential keys or client secrets here.

# Voxa Go API origin (must be listed in the server's VOXA_ALLOWED_ORIGINS for this web origin).
NEXT_PUBLIC_VOXA_API_URL=http://127.0.0.1:8080

# "oidc" (default) or "development" (only against a server running VOXA_AUTH_MODE=development).
NEXT_PUBLIC_VOXA_AUTH_MODE=development

# OIDC (Authorization Code + PKCE, public client: no secret).
# Must equal the server's VOXA_OIDC_ISSUER exactly.
#NEXT_PUBLIC_VOXA_OIDC_ISSUER=https://id.example.com/realms/voxa
#NEXT_PUBLIC_VOXA_OIDC_CLIENT_ID=voxa-web
#NEXT_PUBLIC_VOXA_OIDC_SCOPE=openid profile email
# Defaults to <web origin>/auth/callback; register it at the provider.
#NEXT_PUBLIC_VOXA_OIDC_REDIRECT_URI=http://localhost:3118/auth/callback
# Token sent as the API bearer: access_token (default) or id_token.
# Its "aud" must match the server's VOXA_OIDC_AUDIENCE.
#NEXT_PUBLIC_VOXA_OIDC_BEARER=access_token
